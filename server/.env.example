APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

AUTH_MODE=development
AUTH_DEVELOPMENT_SUBJECT=local-developer
AUTH_DEVELOPMENT_DISPLAY_NAME=Local Developer

MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=access_gateway
MYSQL_USER=access_gateway
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL_MODE=disabled

DOCUMENT_ENCRYPTION_KEY_ID=local-v1
DOCUMENT_ENCRYPTION_KEY_BASE64=

NATIVE_VALIDATOR_PATH=
NATIVE_VALIDATOR_CONTRACT_VERSION=1
NATIVE_VALIDATOR_TIMEOUT_MILLIS=10000
# Must be at least the max projectRoute payload reported by --describe-config-limits.
NATIVE_VALIDATOR_MAX_INPUT_BYTES=4194304
NATIVE_VALIDATOR_MAX_OUTPUT_BYTES=1048576

PUBLICATION_WORKER_ENABLED=false
PUBLICATION_NACOS_ENDPOINT=
NACOS_REQUEST_TIMEOUT_MILLIS=5000
NACOS_MAX_RESPONSE_BYTES=5242880
PUBLICATION_POLL_INTERVAL_MILLIS=1000
PUBLICATION_LEASE_MILLIS=30000

# Run the collector as a separate process. The API may set ENABLED=true with
# no targets so capability reporting is accurate without loading bearer tokens.
ACTIVATION_COLLECTOR_ENABLED=false
# JSON array: [{"environmentCode":"dev","instanceKey":"access-0",
# "endpoint":"http://127.0.0.1:16689/v1/activation-evidence","token":"<32+ bytes>"}]
# Configure this only in the activation-collector process environment.
ACTIVATION_TARGETS_JSON=
ACTIVATION_REQUEST_TIMEOUT_MILLIS=5000
ACTIVATION_MAX_RESPONSE_BYTES=1048576
ACTIVATION_POLL_INTERVAL_MILLIS=5000
ACTIVATION_EVIDENCE_TTL_MILLIS=15000
ACTIVATION_LEASE_MILLIS=30000
ACTIVATION_MAX_PAGES=16
ACTIVATION_MAX_PROJECTS=1024
ACTIVATION_CONCURRENCY=4
