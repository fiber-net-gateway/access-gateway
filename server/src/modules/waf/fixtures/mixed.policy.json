{
  "schemaVersion": 1,
  "defaultMode": "block",
  "projectModes": {
    "loan-admin": "log",
    "loan-admin-legacy": "off",
    "trade-web": "block"
  },
  "rules": [
    {
      "id": "sqli-0023",
      "name": "union select 注入探测",
      "severity": "high",
      "priority": 100,
      "action": "block",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"(?i)union[+%20\\\\s]+select\") || strings.match($query.q, \"(?i)union\\\\s+select\")",
      "scope": {
        "methods": ["GET", "POST"],
        "paths": ["/api/*", "/loan/apply"],
        "sourceCidrs": ["172.28.0.0/16", "10.164.44.2/32"]
      },
      "exclusions": [
        {
          "project": "loan-web",
          "reason": "内部报表导出含 SQL 片段, 2026-11-05 张三"
        }
      ]
    },
    {
      "id": "scanner-ua",
      "name": "scanner user agents",
      "severity": "medium",
      "priority": 10,
      "action": "log",
      "phase": "request_head",
      "match": "strings.match($header.user_agent, \"(?i)(sqlmap|nikto|nmap)\")"
    },
    {
      "id": "path-traversal",
      "name": "path traversal probe",
      "severity": "critical",
      "priority": 100,
      "action": "block",
      "phase": "request_head",
      "match": "strings.contains($req.path, \"../\")",
      "scope": {
        "sourceCidrs": ["10.164.44.2/32", "172.28.0.0/16"]
      }
    }
  ]
}
