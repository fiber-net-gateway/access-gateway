{
  "schemaVersion": 2,
  "groups": [
    {
      "id": "sqli",
      "name": "SQL 注入",
      "mode": "log",
      "priority": 100,
      "projects": {
        "include": ["*"]
      }
    },
    {
      "id": "rce",
      "name": "远程代码执行",
      "mode": "log",
      "priority": 120,
      "projects": {
        "include": ["*"]
      }
    },
    {
      "id": "xss",
      "name": "XSS",
      "mode": "log",
      "priority": 200,
      "projects": {
        "include": ["*"]
      }
    },
    {
      "id": "traversal",
      "name": "路径穿越",
      "mode": "log",
      "priority": 300,
      "projects": {
        "include": ["*"]
      }
    },
    {
      "id": "probe",
      "name": "扫描与探测",
      "mode": "log",
      "priority": 400,
      "projects": {
        "include": ["*"]
      }
    },
    {
      "id": "malformed",
      "name": "畸形请求",
      "mode": "log",
      "priority": 500,
      "projects": {
        "include": ["*"]
      }
    }
  ],
  "rules": [
    {
      "id": "sqli-union-select",
      "name": "union select 注入探测",
      "group": "sqli",
      "severity": "critical",
      "priority": 100,
      "action": "block",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"(?i)union(?:[+%20]|\\\\s)+(?:all\\\\s+)?select\")"
    },
    {
      "id": "sqli-time-function",
      "name": "SQL 延时函数探测",
      "group": "sqli",
      "severity": "high",
      "priority": 110,
      "action": "block",
      "phase": "request_head",
      "match": "strings.match($req.query, \"(?i)(?:sleep|benchmark|waitfor|pg_sleep)\\\\s*\\\\(\")"
    },
    {
      "id": "rce-jndi-probe",
      "name": "JNDI 注入探测（log4shell 形态）",
      "group": "rce",
      "severity": "critical",
      "priority": 120,
      "action": "block",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"(?i)[$][{]jndi:\") || strings.match($header.user_agent, \"(?i)[$][{]jndi:\") || strings.match($header.referer, \"(?i)[$][{]jndi:\")"
    },
    {
      "id": "xss-script-marker",
      "name": "XSS 脚本标记探测",
      "group": "xss",
      "severity": "high",
      "priority": 200,
      "action": "block",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"(?i)(?:<\\\\s*script|<\\\\s*iframe|javascript:|on(?:error|load|click)\\\\s*=)\")"
    },
    {
      "id": "traversal-encoded-dotdot",
      "name": "路径穿越探测（含编码变体）",
      "group": "traversal",
      "severity": "high",
      "priority": 300,
      "action": "block",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"(?i)(?:[.][.]|%2e%2e|%252e%252e)(?:/|%2f|%5c|%255c)\")"
    },
    {
      "id": "scanner-user-agent",
      "name": "扫描器 User-Agent",
      "group": "probe",
      "severity": "medium",
      "priority": 400,
      "action": "log",
      "phase": "request_head",
      "match": "strings.match($header.user_agent, \"(?i)(?:sqlmap|nikto|nmap|masscan|zgrab|acunetix|nessus|dirbuster|gobuster|wpscan)\")"
    },
    {
      "id": "probe-sensitive-file",
      "name": "敏感文件与管理端探测",
      "group": "probe",
      "severity": "medium",
      "priority": 410,
      "action": "log",
      "phase": "request_head",
      "match": "strings.match($req.path, \"(?i)^/[.](?:env|git|htaccess|htpasswd|ssh|aws)|/(?:phpmyadmin|wp-admin|wp-login[.]php|actuator)(?:/|$)\")"
    },
    {
      "id": "malformed-control-chars",
      "name": "URI 控制字符",
      "group": "malformed",
      "severity": "medium",
      "priority": 500,
      "action": "block",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]\")"
    },
    {
      "id": "malformed-triple-encoding",
      "name": "三重百分号编码探测",
      "group": "malformed",
      "severity": "low",
      "priority": 510,
      "action": "log",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"%[0-9a-f]{2}%[0-9a-f]{2}%[0-9a-f]{2}\")"
    }
  ],
  "projectModes": {}
}
