{
  "schemaVersion": 2,
  "groups": [
    {
      "id": "malformed",
      "name": "畸形请求",
      "mode": "log",
      "priority": 100,
      "projects": {
        "include": ["*"]
      }
    }
  ],
  "projectModes": {
    "loan-admin-legacy": "off"
  },
  "rules": [
    {
      "id": "malformed-uri",
      "name": "畸形 URI 探测",
      "group": "malformed",
      "severity": "low",
      "priority": 0,
      "action": "log",
      "phase": "request_head",
      "match": "strings.match($req.uri, \"%[0-9a-f]{2}%[0-9a-f]{2}%[0-9a-f]{2}\")"
    }
  ]
}
