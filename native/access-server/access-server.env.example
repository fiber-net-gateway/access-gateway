# Java unified-access allows a 400 MiB request body.
#
# TLS listener: HTTPS, HTTP/2 (ALPN), and HTTP/3 (QUIC UDP) on the same port.
# Enabled by default; the complete certificate snapshot is watched from Nacos
# and startup waits for its first valid value. When TLS is disabled this
# address:port stays closed entirely.
ACCESS_SERVER_TLS_LISTEN_ADDRESS=0.0.0.0
ACCESS_SERVER_TLS_LISTEN_PORT=8443
ACCESS_SERVER_TLS_ENABLED=true
ACCESS_SERVER_TLS_CERTIFICATES_DATA_ID=ploto.unified-access.tls-certificates
ACCESS_SERVER_TLS_CERTIFICATES_GROUP=ACCESS-SERVER
ACCESS_SERVER_HTTP3_ENABLED=true

# Plaintext HTTP/1.1 listener, served alongside the TLS listener. When TLS is
# disabled this is the only traffic listener and at least one of the two
# must be enabled. The two listeners must not share an address:port.
ACCESS_SERVER_PLAIN_LISTEN_ENABLED=true
ACCESS_SERVER_PLAIN_LISTEN_ADDRESS=0.0.0.0
ACCESS_SERVER_PLAIN_LISTEN_PORT=8000

# Outbound HTTPS preserves the Java insecure trust behavior by default. Use
# system_ca in production when upstream certificates chain to the host trust
# store, or custom_ca with a mounted PEM CA bundle. The custom path is loaded
# before EventLoops start and is never included in runtime error messages.
ACCESS_SERVER_UPSTREAM_TLS_MODE=legacy_insecure
ACCESS_SERVER_UPSTREAM_TLS_CA_FILE=

# One deadline covers all resolved addresses for one selected upstream. Happy
# Eyeballs is enabled by default and races at most four fixed-capacity attempts;
# v6_first/v4_first controls family interleaving, not DNS query order.
ACCESS_SERVER_UPSTREAM_CONNECT_TIMEOUT_MILLIS=3000
ACCESS_SERVER_HAPPY_EYEBALLS_ENABLED=true
ACCESS_SERVER_HAPPY_EYEBALLS_DELAY_MILLIS=250
ACCESS_SERVER_HAPPY_EYEBALLS_MAX_CONCURRENT_ATTEMPTS=2
ACCESS_SERVER_HAPPY_EYEBALLS_FIRST_ADDRESS_FAMILY_COUNT=1
ACCESS_SERVER_HAPPY_EYEBALLS_ADDRESS_POLICY=v6_first

# Upstream hostnames use Fiber's bounded resolver configuration. system loads
# this file once before EventLoops start, preserves up to three ordered
# nameservers plus timeout/attempts/rotate, and has no implicit public fallback.
# override ignores the file and requires 1-3 comma-separated unicast IPs.
ACCESS_SERVER_DNS_MODE=system
ACCESS_SERVER_DNS_RESOLV_CONF=/etc/resolv.conf
# ACCESS_SERVER_DNS_SERVERS=127.0.0.1,::1
# Prometheus uses an independently configured status listener and serves text
# only on /metrics. Port 8001 is a fixed default, not a value derived from either
# traffic port; for example production may use HTTP 80, HTTPS 443, and metrics
# 9090. The status listener must not collide with either traffic listener's
# address:port.
ACCESS_SERVER_METRICS_LISTEN_ADDRESS=0.0.0.0
ACCESS_SERVER_METRICS_LISTEN_PORT=8001

# High-cardinality instance activation evidence shares the status listener but
# is disabled by default and independently authenticated. Enabling it requires
# a stable 1-255 byte instance ID using [A-Za-z0-9._:-] and a unique printable
# ASCII bearer token of 32-512 bytes. Keep the listener on a private network or
# terminate TLS before it; never reuse a token between instances.
ACCESS_SERVER_ACTIVATION_EVIDENCE_ENABLED=false
ACCESS_SERVER_INSTANCE_ID=
ACCESS_SERVER_ACTIVATION_TOKEN=
ACCESS_SERVER_INITIAL_CONFIG_TIMEOUT_MILLIS=60000
ACCESS_SERVER_MAX_REQUEST_BODY_SIZE=419430400
# Response-body cap for proxied upstream responses when the route does not
# configure max_proxy_body_size; mirrors the Java unified-access default
# (fiber.http.client.maxBodySize = 600 MiB in the deployed Startup). Set 0 to
# disable the cap and forward responses of any size.
ACCESS_SERVER_MAX_RESPONSE_BODY_SIZE=629145600
# Enable only for the Java test-environment Host form: api_gray.example.com.
ACCESS_SERVER_TEST_MODE=false

# Client identity is derived from the socket peer by default; all forwarding
# headers are ignored. Use trusted_proxy only when every listed CIDR is an
# actual ingress/LB hop controlled by this deployment. legacy_headers preserves
# the old Java-compatible trust-all behavior and must not be used on a listener
# reachable from an untrusted network.
ACCESS_SERVER_CLIENT_METADATA_MODE=direct
ACCESS_SERVER_TRUSTED_PROXY_CIDRS=

# Java-compatible access log: one tab-separated line per proxy attempt in
# access.log under this directory (rotated to access-YYYY-MM-DD.<N>.log at
# 100 MB, keeping 300 archives / 30 days). Leave empty to disable access
# logging entirely. The directory must exist and be writable; open failures
# are reported on stderr and logging retries without failing the server.
ACCESS_SERVER_ACCESS_LOG_DIR=/data/logs/ploto-server

# These defaults preserve the ploto-unified-access Nacos contract.
ACCESS_SERVER_PROJECTS_DATA_ID=ploto.unified-access.projects
ACCESS_SERVER_ROUTE_DATA_ID_PREFIX=ploto.unified-access.route.
ACCESS_SERVER_ROUTE_GROUP=ACCESS-SERVER
ACCESS_SERVER_GRAY_DATA_ID=ploto.unified-access.gray-match
# Test-env-only whitelist (service -> cluster set) that keeps request-specified
# clusters from falling back to the configured cluster. Only subscribed when
# ACCESS_SERVER_TEST_MODE=true.
ACCESS_SERVER_TEMP_CLUSTER_DATA_ID=ploto.test.temp-cluster-apps
ACCESS_SERVER_NAMING_GROUP=DEFAULT_GROUP
ACCESS_SERVER_ZONE=

# Normal cold startup binds listeners first, registers this concrete address:port in
# Nacos, waits until NamingService reports Registered, and only then starts
# accepting traffic. plain is the default while the plaintext listener is
# enabled; use tls for TLS-only deployments. Set an explicit advertise address
# when the selected listener binds a wildcard address and automatic local IPv4
# selection is not the address reachable by other services.
# Prewarm upgrade needs no env keys: access-server-boss starts this process with
# --boss-fd=3 and access-serverctl drives the upgrade. The upgraded generation
# serves immediately after the old one releases its TCP listeners, then
# registers in the background. Both generations must use fixed traffic/status
# ports. HTTP/3 uses UDP REUSEPORT; old UDP sockets drain without blocking the
# handoff, but HTTP/3 requests may fail throughout process overlap. See
# docs/access-server-prewarm-upgrade-design.md.
ACCESS_SERVER_SERVICE_NAME=unified-access-server
ACCESS_SERVER_CLUSTER=dev
ACCESS_SERVER_ADVERTISE_ADDRESS=
ACCESS_SERVER_REGISTRATION_LISTENER=plain
ACCESS_SERVER_REGISTRATION_TIMEOUT_MILLIS=10000

# Nacos intentionally remains IP-literal-only and therefore does not borrow the
# HTTP worker resolver. Use a comma-separated list.
NACOS_SERVER_ADDRESSES=127.0.0.1
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_NAMESPACE=public
NACOS_TENANT=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CLIENT_VERSION=fiber-access-server/1.0

# CAT is disabled when all five settings stay empty. Once any setting is
# non-empty, app key, hostname, IP, and at least one router/collector endpoint
# must form a valid local apps/cat configuration.
CAT_APP_KEY=
CAT_HOSTNAME=
CAT_IP=
CAT_ROUTER_ADDRESSES=
CAT_COLLECTOR_ADDRESSES=
