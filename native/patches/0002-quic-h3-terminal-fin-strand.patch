+
+// A proxied response whose terminal write lands after the body extent was
+// already encoded (ServerHttp3Request -> QuicStream::write(nullptr, 0, true))
+// must be able to emit its fin-only STREAM frame immediately: offsets are
+// absolute and the peer reassembles out of order. Waiting for the body ACK
+// stranded the FIN on connections with no further send activity.
+TEST(QuicStreamSendQueueTest, FinOnlyFrameEncodesWhileBodyInflight) {
+    fiber::mem::IoBufNodePool pool;
+    fiber::quic::QuicStreamSendQueue queue(pool);
+
+    ASSERT_TRUE(queue.try_append(iobuf_of("abcdef")).has_value());
+
+    std::array<std::uint8_t, 64> out{};
+
+    auto body = fiber::quic::QuicStreamSendQueueTestAccess::encode_stream_frame(queue, 0, out.data(), out.size());
+    ASSERT_TRUE(body.has_value());
+    ASSERT_TRUE(body->encoded);
+    ASSERT_FALSE(body->fin);
+    EXPECT_EQ(queue.inflight_bytes(), 6u);
+
+    ASSERT_TRUE(queue.try_append(fiber::mem::IoBuf{}, true).has_value());
+    ASSERT_TRUE(queue.has_final_size());
+    EXPECT_EQ(queue.final_size(), 6u);
+
+    auto fin_try = fiber::quic::QuicStreamSendQueueTestAccess::encode_stream_frame(queue, 0, out.data(), out.size());
+    ASSERT_TRUE(fin_try.has_value());
+    ASSERT_TRUE(fin_try->encoded) << "fin-only frame must encode while the body is inflight";
+    ASSERT_TRUE(fin_try->fin);
+    EXPECT_EQ(fin_try->data_len, 0u);
+    EXPECT_EQ(fin_try->offset, 6u);
+    EXPECT_FALSE(fin_try->has_length);
+    EXPECT_EQ(queue.fin_acked(), false);
+
+    // Losing the fin packet re-arms it for retransmission.
+    ASSERT_TRUE(fiber::quic::QuicStreamSendQueueTestAccess::mark_failed(queue, fin_try->offset, fin_try->data_len,
+                                                                       fin_try->fin)
+                        .has_value());
+    auto retransmit = fiber::quic::QuicStreamSendQueueTestAccess::encode_stream_frame(queue, 0, out.data(),
+                                                                                     out.size());
+    ASSERT_TRUE(retransmit.has_value());
+    ASSERT_TRUE(retransmit->encoded);
+    ASSERT_TRUE(retransmit->fin);
+
+    // Body ACK releases the extent; a further encode has no pending fin left
+    // to emit (fin is inflight), so it reports nothing to send.
+    ASSERT_TRUE(fiber::quic::QuicStreamSendQueueTestAccess::mark_acked(queue, body->offset, body->data_len,
+                                                                      body->fin)
+                        .has_value());
+    EXPECT_EQ(queue.inflight_bytes(), 0u);
+
+    auto idle = fiber::quic::QuicStreamSendQueueTestAccess::encode_stream_frame(queue, 0, out.data(), out.size());
+    ASSERT_TRUE(idle.has_value());
+    EXPECT_FALSE(idle->encoded);
+
+    // ACKing the fin completes the stream.
+    ASSERT_TRUE(fiber::quic::QuicStreamSendQueueTestAccess::mark_acked(queue, fin_try->offset, fin_try->data_len,
+                                                                      fin_try->fin)
+                        .has_value());
+    EXPECT_TRUE(queue.fin_acked());
+}
